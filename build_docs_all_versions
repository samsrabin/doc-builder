        # Error if it contains uncommitted changes
        cmd = f"git add . && git diff --quiet {thing} && git diff --cached --quiet {thing}"
        try:
            subprocess.check_output(cmd, shell=True)
        except subprocess.CalledProcessError as e:
            subprocess.check_output(
                "git reset", shell=True
            )  # Unstage files staged by `git add`
            msg = f"Important file/submodule may contain uncommitted changes: '{thing}'"
