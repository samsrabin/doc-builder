def move_dir(src, dst):
    """
    Move the built docs to publish directory
    """
    if not os.path.exists(dst):
        os.makedirs(dst)
    subprocess.check_output("mv " + src + "* " + dst, shell=True)


def check_version_list():
    """
    Check version list for problems
    """
    has_default = False
    for version in VERSION_LIST:
        # Expect at most one version with landing_version True
        if version.landing_version:
            if has_default:
                raise RuntimeError(
                    "Expected at most one version with landing_version True"
                )
            has_default = True


def main():

    # Check version list for problems
    check_version_list()

    # and looping over all values to call our build with version, language and its tag
    for version in VERSION_LIST:
        checkout_and_build(version)
        src = os.path.join(BUILD_DIR, "versions", version.short_name, "html")
        dst = os.path.join(PUBLISH_DIR, version.subdir())
        shutil.move(src, dst)


if __name__ == "__main__":
    main()
